# Local: SQLite automatically stored in data/beeguard.sqlite3.
# Optional PowerShell override:
# $env:BEEGUARD_DB_PATH = 'data/beeguard.sqlite3'
#
# Vercel: DATABASE_URL is required.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Para habilitar a exclusão definitiva, configure uma chave secreta em produção.
# BEEGUARD_DELETE_KEY=
# This example is a reference; export variables into the process or Vercel settings.
